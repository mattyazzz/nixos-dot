{
    // ========================
    // ==                    ==
    // ==   the esqueleton   ==
    // ==                    ==
    // ========================

    "layer": "top",
    "position": "top",
    "width": 1366,
    "modules-left": [
        "custom/logo"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "pulseaudio",
        "network",
        "battery",
        "tray"
    ],

    // ========================
    // ==                    ==
    // ==    the modules     ==
    // ==                    ==
    // ========================

    "custom/logo": {
        "format": "",
        "tooltip": "nixos btw",
        "on-click": "rofi -show drun"
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },

    "battery": {
        "format": "{capacity}% {icon}",
        "tooltip-format": "{capacity}% ({time})",
        "format-icons": [" ", " ", " ", " ", " "]
    },
    "network": {
        "format-wifi": "{essid}",
        "format-disconnected": "sin internet, por gil"
    }
}