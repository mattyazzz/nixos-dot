{
    // ========================
    // ==                    ==
    // ==   the esqueleton   ==
    // ==                    ==
    // ========================

    "layer": "top",
    "position": "top",
    "width": 100,
    "modules-left": [
        "custom/logo"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "pulseaudio",
        "network",
        "battery",
        "tray"
    ],

    // ========================
    // ==                    ==
    // ==    the modules     ==
    // ==                    ==
    // ========================

    "custom/logo": {
        "format": "",
        "tooltip": "nixos",
        "on-click": "kitty -e htop"
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },

    "battery": {
        "format": "{capacity}% {icon}",
        "tooltip-format": "{capacity}% ({time})",
        "format-icons": ["", "", "", "", ""]
    }
}